{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "PowerShell(git status*)",
      "Bash(git diff*)",
      "PowerShell(git diff*)",
      "Bash(git log*)",
      "PowerShell(git log*)",
      "Bash(git show*)",
      "PowerShell(git show*)",
      "Bash(git fetch*)",
      "PowerShell(git fetch*)",
      "Bash(git rev-parse*)",
      "PowerShell(git rev-parse*)",
      "Bash(git branch --show-current)",
      "PowerShell(git branch --show-current)",
      "Bash(git branch -a*)",
      "PowerShell(git branch -a*)",
      "Bash(git branch --list*)",
      "PowerShell(git branch --list*)",
      "Bash(git merge-base*)",
      "PowerShell(git merge-base*)",
      "Bash(git ls-files*)",
      "PowerShell(git ls-files*)",
      "Bash(git check-ignore*)",
      "PowerShell(git check-ignore*)",
      "Bash(git tag --list*)",
      "PowerShell(git tag --list*)",
      "Bash(git tag -l*)",
      "PowerShell(git tag -l*)",
      "Bash(pytest*)",
      "PowerShell(pytest*)",
      "Bash(python -m pytest*)",
      "PowerShell(python -m pytest*)",
      "Bash(ruff check*)",
      "PowerShell(ruff check*)",
      "Bash(python -m ruff check*)",
      "PowerShell(python -m ruff check*)",
      "Bash(ruff format --check*)",
      "PowerShell(ruff format --check*)",
      "Bash(uv run pytest*)",
      "PowerShell(uv run pytest*)",
      "Bash(uv run ruff check*)",
      "PowerShell(uv run ruff check*)",
      "Bash(gh run list*)",
      "PowerShell(gh run list*)",
      "Bash(gh run view*)",
      "PowerShell(gh run view*)",
      "Bash(gh run watch*)",
      "PowerShell(gh run watch*)",
      "Bash(gh pr view*)",
      "PowerShell(gh pr view*)",
      "Bash(git add*)",
      "PowerShell(git add*)",
      "Bash(git commit*)",
      "PowerShell(git commit*)",
      "Bash(git switch*)",
      "PowerShell(git switch*)",
      "Bash(git checkout*)",
      "PowerShell(git checkout*)",
      "Bash(git merge*)",
      "PowerShell(git merge*)",
      "Bash(git branch*)",
      "PowerShell(git branch*)",
      "Bash(git stash*)",
      "PowerShell(git stash*)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git tag*)",
      "PowerShell(git tag*)",
      "Bash(gh release*)",
      "PowerShell(gh release*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git rebase*)",
      "PowerShell(git rebase*)",
      "Bash(git clean*)",
      "PowerShell(git clean*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push --mirror*)",
      "PowerShell(git push --mirror*)",
      "Bash(git * --no-verify*)",
      "PowerShell(git * --no-verify*)",
      "Bash(git commit -n*)",
      "PowerShell(git commit -n*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*private_key*)",
      "Read(**/*.pem)",
      "Read(**/license.dat)",
      "Bash(git push*gh-pages*)",
      "PowerShell(git push*gh-pages*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gitflow_guard.py\" claude"
          }
        ]
      }
    ]
  }
}
